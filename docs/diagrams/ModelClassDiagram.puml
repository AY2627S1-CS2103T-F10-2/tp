@startuml
!pragma layout smetana
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

package Model <<Rectangle>> {
Class "<<interface>>\nReadOnlyCourseClassBook" as ReadOnlyCourseClassBook
Class "<<interface>>\nReadOnlyUserPrefs" as ReadOnlyUserPrefs
Class "<<interface>>\nModel" as Model
Class CourseClassBook
Class ModelManager
Class UserPrefs
Class UniqueCourseClassList
Class CourseClass
Class UniqueStudentList
Class Student
Class Note
Class StudentName
Class Telehandle
Class ClassGroup
Class CourseCode
Class HomeworkStatus
Class Tag
}

CourseClassBook .up.|> ReadOnlyCourseClassBook
ModelManager .up.|> Model
Model --> ReadOnlyCourseClassBook
Model --> ReadOnlyUserPrefs
ModelManager --> "1" CourseClassBook
ModelManager --> "1" UserPrefs
ModelManager --> "* filtered" CourseClass
UserPrefs .up.|> ReadOnlyUserPrefs

CourseClassBook *--> "1" UniqueCourseClassList
UniqueCourseClassList --> "*" CourseClass
CourseClass *--> ClassGroup
CourseClass *--> CourseCode
CourseClass *--> HomeworkStatus
CourseClass *--> "*" Tag
CourseClass *--> "1" UniqueStudentList
UniqueStudentList --> "*" Student
Student *--> StudentName
Student *--> Telehandle
Student *--> "*" Note
@enduml
