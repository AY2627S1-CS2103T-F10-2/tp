@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor STORAGE_COLOR
skinparam classBackgroundColor STORAGE_COLOR

package Storage as StoragePackage {
    Class "<<interface>>\nStorage" as Storage
    Class StorageManager

    package "UserPrefs Storage" #F4F6F6 {
        Class JsonUserPrefsStorage
    }

    package "CourseClassBook Storage" #F4F6F6 {
        Class JsonCourseClassBookStorage
        Class CourseClassBookStorageData
        Class JsonSerializableCourseClassBook
        Class JsonAdaptedCourseClass
    }
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Storage

StorageManager .up.|> Storage
StorageManager -down-> "1" JsonUserPrefsStorage
StorageManager -down-> "1" JsonCourseClassBookStorage

JsonCourseClassBookStorage ..> JsonSerializableCourseClassBook : read/write
JsonCourseClassBookStorage --> CourseClassBookStorageData : returns

JsonSerializableCourseClassBook --> "*" JsonAdaptedCourseClass : courseClasses
JsonSerializableCourseClassBook "1" *-- "0..*" JsonSerializableCourseClassBook : undoHistory
@enduml
