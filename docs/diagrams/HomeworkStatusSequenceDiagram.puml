@startuml
!include style.puml
skinparam ArrowFontStyle plain

title Updating a course class's homework status

actor User as user USER_COLOR

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":SetHomeworkStatusCommandParser" as SetHomeworkStatusCommandParser LOGIC_COLOR
participant "h:SetHomeworkStatusCommand" as SetHomeworkStatusCommand LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant ":Model" as Model MODEL_COLOR
participant "c:CourseClass" as CourseClass MODEL_COLOR
end box

box Storage STORAGE_COLOR_T1
participant ":Storage" as Storage STORAGE_COLOR
end box

box UI UI_COLOR_T1
participant ":CourseClassCard" as CourseClassCard UI_COLOR
end box

user -[USER_COLOR]> LogicManager : execute("hwork 1 s/completed")
activate LogicManager LOGIC_COLOR

LogicManager -[LOGIC_COLOR]> AddressBookParser : parseCommand("hwork 1 s/completed")
activate AddressBookParser LOGIC_COLOR

AddressBookParser -[LOGIC_COLOR]> SetHomeworkStatusCommandParser : parse("1 s/completed")
activate SetHomeworkStatusCommandParser LOGIC_COLOR

create SetHomeworkStatusCommand
SetHomeworkStatusCommandParser -[LOGIC_COLOR]> SetHomeworkStatusCommand : create(index, COMPLETED)
activate SetHomeworkStatusCommand LOGIC_COLOR
SetHomeworkStatusCommandParser -[LOGIC_COLOR]> AddressBookParser : h
deactivate SetHomeworkStatusCommandParser

AddressBookParser -[LOGIC_COLOR]> LogicManager : h
deactivate AddressBookParser

LogicManager -[LOGIC_COLOR]> SetHomeworkStatusCommand : execute(model)

SetHomeworkStatusCommand -[MODEL_COLOR]> Model : getFilteredCourseClassList()
activate Model MODEL_COLOR
Model -[MODEL_COLOR]> SetHomeworkStatusCommand : filtered classes
deactivate Model

SetHomeworkStatusCommand -[MODEL_COLOR]> CourseClass : getHomeworkStatus()
activate CourseClass MODEL_COLOR
CourseClass -[MODEL_COLOR]> SetHomeworkStatusCommand : previous status
deactivate CourseClass

SetHomeworkStatusCommand -[MODEL_COLOR]> CourseClass : setHomeworkStatus(COMPLETED)

CourseClass -[UI_COLOR]> CourseClassCard : homeworkStatusProperty changed
activate CourseClassCard UI_COLOR
CourseClassCard -[UI_COLOR]> CourseClass : getHomeworkStatus()
CourseClass -[UI_COLOR]> CourseClassCard : refreshHomeworkStatus()
deactivate CourseClassCard

SetHomeworkStatusCommand -[MODEL_COLOR]> Model : updateFilteredCourseClassList(show all)
SetHomeworkStatusCommand -[LOGIC_COLOR]> LogicManager : CommandResult
deactivate SetHomeworkStatusCommand

LogicManager -[STORAGE_COLOR]> Storage : saveCourseClassBook(model.getCourseClassBook())
activate Storage STORAGE_COLOR
Storage -[STORAGE_COLOR]> Storage : write courseclasses.json
Storage --[STORAGE_COLOR]> LogicManager
deactivate Storage

LogicManager -[LOGIC_COLOR]> user : success message
deactivate LogicManager

@enduml
