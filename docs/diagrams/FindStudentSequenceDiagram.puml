@startuml
!include style.puml
skinparam ArrowFontStyle plain

actor "Teaching Assistant" as User USER_COLOR

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant "p:FindStudentCommandParser" as Parser LOGIC_COLOR
participant "c:FindStudentCommand" as Command LOGIC_COLOR
participant "r:CommandResult" as Result LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
participant "b:CourseClassBook" as Book MODEL_COLOR
participant "cc:CourseClass" as CourseClass MODEL_COLOR
participant "predicate:\nStudentNameContainsKeywordsPredicate" as Predicate MODEL_COLOR
end box

User -> LogicManager : execute("fstudent Alex")
activate LogicManager

LogicManager -> AddressBookParser : parseCommand("fstudent Alex")
activate AddressBookParser

create Parser
AddressBookParser -> Parser
activate Parser
Parser --> AddressBookParser
deactivate Parser

AddressBookParser -> Parser : parse(" Alex")
activate Parser
create Predicate
Parser -> Predicate : new(["Alex"])
create Command
Parser -> Command : new(predicate)
Command --> Parser : c
Parser --> AddressBookParser : c
deactivate Parser
AddressBookParser --> LogicManager : c
deactivate AddressBookParser

LogicManager -> Command : execute(m)
activate Command
Command -> Model : getCourseClassBook()
Model --> Command : b
Command -> Book : getCourseClassList()
Book --> Command : courseClasses

loop for each course class cc
    Command -> CourseClass : getStudentList()
    CourseClass --> Command : students
    loop for each student
        Command -> Predicate : test(student)
        Predicate --> Command : matches
    end
end

create Result
Command -> Result : new(search summary)
Result --> Command : r
Command --> LogicManager : r
deactivate Command

LogicManager --> User : r
deactivate LogicManager
@enduml
