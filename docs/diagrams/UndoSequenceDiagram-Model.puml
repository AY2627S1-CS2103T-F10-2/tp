@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant "u:UndoCommand" as UndoCommand LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:ModelManager" as ModelManager MODEL_COLOR
participant "h:Deque<CourseClassBook>" as UndoHistory MODEL_COLOR
participant "c:CourseClassBook" as CourseClassBook MODEL_COLOR
end box

UndoCommand -> ModelManager : undoCourseClassBook()
activate ModelManager

alt undo history is empty
    ModelManager --> UndoCommand : Optional.empty()
else snapshot is available
    ModelManager -> UndoHistory : removeLast()
    UndoHistory --> ModelManager : restored snapshot

    ModelManager -> CourseClassBook : resetData(restored snapshot)
    activate CourseClassBook
    CourseClassBook --> ModelManager
    deactivate CourseClassBook

    ModelManager --> UndoCommand : Optional.of(restored)
end

deactivate ModelManager

@enduml
