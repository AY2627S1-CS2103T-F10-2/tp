@startuml
!include style.puml

actor User

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":DeleteStudentCommandParser" as DeleteStudentCommandParser LOGIC_COLOR
participant "d:DeleteStudentCommand" as DeleteStudentCommand LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant ":Model" as Model MODEL_COLOR
participant "c:CourseClass" as CourseClass MODEL_COLOR
participant ":UniqueStudentList" as UniqueStudentList MODEL_COLOR
end box

box Storage STORAGE_COLOR_T1
participant ":Storage" as Storage STORAGE_COLOR
end box

User -> LogicManager : execute("dstudent t/birdman c/T05 m/CS2103T")
activate LogicManager

LogicManager -> AddressBookParser : parseCommand(...)
activate AddressBookParser
AddressBookParser -> DeleteStudentCommandParser : parse(...)
activate DeleteStudentCommandParser
create DeleteStudentCommand
DeleteStudentCommandParser -> DeleteStudentCommand : create command
DeleteStudentCommand --> DeleteStudentCommandParser
deactivate DeleteStudentCommandParser
AddressBookParser --> LogicManager : d
deactivate AddressBookParser

LogicManager -> DeleteStudentCommand : execute(Model)
activate DeleteStudentCommand
DeleteStudentCommand -> Model : findCourseClassByGroup(T05, CS2103T)
Model --> DeleteStudentCommand : c
DeleteStudentCommand -> CourseClass : hasStudent(birdman)
CourseClass -> UniqueStudentList : containsTelehandle(birdman)
UniqueStudentList --> CourseClass : true
CourseClass --> DeleteStudentCommand : true
DeleteStudentCommand --> LogicManager : confirmation preview
deactivate DeleteStudentCommand
LogicManager -> LogicManager : store pending command
LogicManager --> User : ask for yes/no confirmation

alt User enters yes
    User -> LogicManager : execute("yes")
    activate LogicManager
    LogicManager -> DeleteStudentCommand : confirm()
    DeleteStudentCommand --> LogicManager : confirmed command
    LogicManager -> DeleteStudentCommand : execute(Model)
    activate DeleteStudentCommand
    DeleteStudentCommand -> Model : findCourseClassByGroup(T05, CS2103T)
    Model --> DeleteStudentCommand : c
    DeleteStudentCommand -> CourseClass : removeStudent(birdman)
    CourseClass -> UniqueStudentList : remove(birdman)
    UniqueStudentList --> CourseClass : student removed
    CourseClass --> DeleteStudentCommand
    DeleteStudentCommand --> LogicManager : success result
    deactivate DeleteStudentCommand
    LogicManager -> Storage : saveCourseClassBookData(...)
    Storage --> LogicManager : saved
    LogicManager --> User : deletion successful
    deactivate LogicManager
else User enters no
    User -> LogicManager : execute("no")
    LogicManager -> LogicManager : clear pending command
    LogicManager --> User : cancellation message
else User enters another input
    User -> LogicManager : execute("maybe")
    LogicManager --> User : confirmation error
end

deactivate LogicManager
@enduml
