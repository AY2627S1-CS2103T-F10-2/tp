@startuml
!pragma layout smetana
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor UI_COLOR_T4
skinparam classBackgroundColor UI_COLOR

package UI <<Rectangle>> {
Class "<<interface>>\nUi" as Ui
Class "{abstract}\nUiPart" as UiPart
Class UiManager
Class MainWindow
Class HelpWindow
Class ResultDisplay
Class CourseClassListPanel
Class CourseClassCard
Class StudentCard
Class StatusBarFooter
Class CommandBox
}

package Model <<Rectangle>> {
Class CourseClass
Class Student
}

package Logic <<Rectangle>> {
Class Logic
}

UiManager .left.|> Ui
UiManager -down-> "1" MainWindow
UiManager -right-> Logic
MainWindow *-down-> "1" CommandBox
MainWindow *-down-> "1" ResultDisplay
MainWindow *-down-> "1" CourseClassListPanel
MainWindow *-down-> "1" StatusBarFooter
MainWindow --> "0..1" HelpWindow
MainWindow -left-> Logic

CourseClassListPanel -down-> "*" CourseClassCard
CourseClassCard -down-> "*" StudentCard
CourseClassCard ..> CourseClass
StudentCard ..> Student

MainWindow --|> UiPart
HelpWindow --|> UiPart
ResultDisplay --|> UiPart
CommandBox --|> UiPart
CourseClassListPanel --|> UiPart
CourseClassCard --|> UiPart
StudentCard --|> UiPart
StatusBarFooter --|> UiPart
@enduml
