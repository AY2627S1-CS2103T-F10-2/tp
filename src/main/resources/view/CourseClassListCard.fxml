<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox id="cardPane" fx:id="cardPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <GridPane HBox.hgrow="ALWAYS">
    <columnConstraints>
      <ColumnConstraints hgrow="SOMETIMES" minWidth="10" prefWidth="150" />
    </columnConstraints>
    <VBox alignment="TOP_LEFT" minHeight="105" GridPane.columnIndex="0">
      <padding>
        <Insets top="5" right="15" bottom="5" left="15" />
      </padding>
      <HBox spacing="10" alignment="BASELINE_LEFT">
        <Label fx:id="id" styleClass="cell_big_label">
          <minWidth>
            <!-- Ensures that the label text is never truncated -->
            <Region fx:constant="USE_PREF_SIZE" />
          </minWidth>
        </Label>
        <Label fx:id="name" text="\$first" styleClass="cell_big_label" />
        <Label fx:id="courseCode" styleClass="cell_small_label" text="Course code" />
        <FlowPane fx:id="tags" alignment = "CENTER_LEFT" prefWrapLength="10"/>
        <Label fx:id="homeworkStatus" styleClass="homework-status" text="Homework: not-set" />
      </HBox>
      <Label fx:id="studentCount"
             styleClass="cell_small_label"
             text="Students"
             maxWidth="Infinity"
             alignment="CENTER_RIGHT">

        <padding>
            <Insets right="10" />
        </padding>
      </Label>
      <StackPane styleClass="student-list">
        <VBox.margin>
          <Insets top="10" bottom="10" />
        </VBox.margin>
        <VBox fx:id="studentsBox" spacing="0" fillWidth="true" />
      </StackPane>
    </VBox>
  </GridPane>
</HBox>
